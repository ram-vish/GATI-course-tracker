rules_version = '2';

// Who can do what in the GATI Course Tracker.
// Everyone must be signed in with a @tataiis.org email AND be listed in the "users" collection.
// Roles: "program" (program team / operations, full access), "cp" (course production),
//        "head" (GATI head for the sources in "gatis"), "viewer" (read only).
//
// Course stages: "pipeline" (GATI pipeline) → "running" → "actual" (completed); or "dropped".
//   1. A GATI head adds a pipeline course.
//   2. Course production acknowledges it (sets cpAck). This cannot be undone.
//   3. The program team confirms the start (→ running) and later marks it completed (→ actual).
service cloud.firestore {
  match /databases/{database}/documents {

    function email() { return request.auth.token.email.lower(); }
    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && email().matches('.*@tataiis[.]org');
    }
    function profilePath() { return /databases/$(database)/documents/users/$(email()); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function isProgram() { return hasProfile() && me().role == 'program'; }
    function isCP() { return hasProfile() && me().role == 'cp'; }
    function isHeadFor(g) { return hasProfile() && me().role == 'head' && g in me().gatis; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function acked(d) { return d.get('cpAck', null) != null; }

    // People and their access. Only the program team adds, edits or removes people.
    // A person may only clear their own "still on the starting password" flag.
    match /users/{id} {
      allow read: if hasProfile();
      allow create, delete: if isProgram();
      allow update: if isProgram()
        || (hasProfile() && id == email() && changed().hasOnly(['defaultPassword']));
    }

    // Lists of schools, labs, holidays and named heads.
    match /config/{doc} {
      allow read: if hasProfile();
      allow write: if isProgram();
    }

    // What a GATI head may change on a course of their own source.
    function headUpdateOK() {
      return
        // Not yet acknowledged: edit freely, or drop it. Cannot acknowledge or move it forward.
        (resource.data.stage == 'pipeline' && !acked(resource.data)
          && isHeadFor(request.resource.data.gati) && !acked(request.resource.data)
          && request.resource.data.stage in ['pipeline', 'dropped'])
        // Acknowledged: dates, numbers and details only; course name, source, school and stage stay fixed.
        || (resource.data.stage == 'pipeline' && acked(resource.data)
          && changed().hasOnly(['plannedStart', 'plannedEnd', 'batchSize', 'confidence', 'notes', 'sat',
                                'trainingDays', 'campus', 'mode', 'batch', 'client', 'programType',
                                'history', 'updatedAt', 'updatedBy']))
        // Dropped before acknowledgement: may be restored.
        || (resource.data.stage == 'dropped' && !acked(resource.data) && !acked(request.resource.data)
          && isHeadFor(request.resource.data.gati) && request.resource.data.stage in ['pipeline', 'dropped'])
        // Completed: file an edit request, or make one edit once the program team unlocks it.
        || (resource.data.stage == 'actual' && request.resource.data.stage == 'actual'
          && (resource.data.get('unlocked', false) == true || changed().hasOnly(['editRequest', 'history'])));
    }

    match /courses/{id} {
      allow read: if hasProfile();
      allow create: if isProgram()
        || (isHeadFor(request.resource.data.gati) && request.resource.data.stage == 'pipeline'
            && !acked(request.resource.data));
      allow update: if isProgram()
        || (isCP() && resource.data.stage == 'pipeline' && !acked(resource.data)
            && changed().hasOnly(['cpAck', 'history', 'updatedAt', 'updatedBy']))
        || (isHeadFor(resource.data.gati) && headUpdateOK());
      allow delete: if isProgram();
    }
  }
}
