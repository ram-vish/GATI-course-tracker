rules_version = '2';

// Who can do what in the Tata IIS Course Tracker.
// Everyone must be signed in with a @tataiis.org email AND be listed in the "users" collection.
// Access: "roles" lists any of "program" (program team / operations), "cp" (course production) and
//         "lead" (leadership); "gatis" lists the sources a person heads. Nothing listed means view only.
//         Older profiles have a single "role" instead of "roles".
// The admin (ram.viswanath@tataiis.org) can do everything, and is the only one who can delete.
//
// Course stages:
//   "pipeline": GATI head adds it, saying whether the course is already available (courseReady → review "approved")
//               or not (review "awaiting"); course production uploads the course (review: awaiting/changes → review);
//               the GATI head approves (→ approved) or asks for changes (→ changes);
//               once approved, the GATI head confirms the batch (→ leadership);
//               leadership approves (→ stage "standby", shown as Upcoming batches) or sends it back (→ approved).
//   "standby":  operations click Batch started (→ "running").
//   "running":  operations click Batch completed (→ "actual").
//   "actual":   completed and locked; GATI heads may request an edit.
//   "dropped":  dropped from the pipeline or a cancelled batch.
service cloud.firestore {
  match /databases/{database}/documents {

    function email() { return request.auth.token.email.lower(); }
    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && email().matches('.*@tataiis[.]org');
    }
    function profilePath() { return /databases/$(database)/documents/users/$(email()); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function isAdmin() { return hasProfile() && email() == 'ram.viswanath@tataiis.org'; }
    function roles() { return me().get('roles', [me().get('role', '')]); }
    function isProgram() { return hasProfile() && 'program' in roles(); }
    function isCP() { return hasProfile() && 'cp' in roles(); }
    function isLead() { return hasProfile() && 'lead' in roles(); }
    // A program team member may be limited to some campuses ("campuses"); none listed means both.
    function campusOK(d) { return me().get('campuses', []).size() == 0 || d.get('campus', '') in me().get('campuses', []); }
    // Anyone who takes part in the flow (not view-only).
    function involved() { return isProgram() || isCP() || isLead() || (hasProfile() && me().get('gatis', []).size() > 0); }
    function isHeadFor(g) { return hasProfile() && g in me().get('gatis', []); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function rv(d) { return d.get('review', 'awaiting'); }

    // People and their access. Only the admin adds, edits or removes people.
    // A person may only clear their own "still on the starting password" flag.
    match /users/{id} {
      allow read: if hasProfile();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (hasProfile() && id == email() && changed().hasOnly(['defaultPassword', 'seen']));
      allow delete: if isAdmin();
    }

    // Lists of schools, labs, holidays and named heads.
    match /config/{doc} {
      allow read: if hasProfile();
      allow write: if isProgram() || isAdmin();
    }

    // Files attached to courses, stored in pieces. Anyone signed in may read; people add their own; only the admin deletes.
    match /files/{fileId} {
      allow read: if hasProfile();
      allow create: if hasProfile() && request.resource.data.by == email();
      allow delete: if isAdmin();
      match /chunks/{chunk} {
        allow read: if hasProfile();
        allow create: if hasProfile() && get(/databases/$(database)/documents/files/$(fileId)).data.by == email();
        allow delete: if isAdmin();
      }
    }

    // GATI head on a pipeline course of their own source.
    function headPipelineOK() {
      let was = rv(resource.data);
      let now = rv(request.resource.data);
      let st = request.resource.data.stage;
      return isHeadFor(request.resource.data.gati)
        // Review moves from "review" to approved or changes, or from approved to leadership (batch confirmed).
        // Before course production starts, the head can switch "course already available" on (→ approved) or back off.
        && (now == was || (was == 'review' && now in ['approved', 'changes']) || (was == 'approved' && now == 'leadership')
            || (was == 'awaiting' && now == 'approved' && request.resource.data.get('courseReady', false) == true)
            || (was == 'approved' && now == 'awaiting' && resource.data.get('courseReady', false) == true))
        // Stays in the pipeline; the GATI head may drop it at any step.
        && (st == 'pipeline' || st == 'dropped')
        // Once course production has started, the course name, source and school stay fixed.
        && (was == 'awaiting' || (was == 'approved' && resource.data.get('courseReady', false) == true)
            || !changed().hasAny(['title', 'gati', 'school']))
        // Only course production uploads course files; the GATI head adds the student list when confirming the batch.
        && (!changed().hasAny(['files']) || (was == 'approved' && now == 'leadership'));
    }

    // Feedback about the tracker. Anyone signed in sends it; only the admin reads all of it and marks it done.
    match /feedback/{id} {
      allow create: if hasProfile() && request.resource.data.by == email();
      allow read: if isAdmin() || (hasProfile() && resource.data.by == email());
      allow update, delete: if isAdmin();
    }

    // Placement details of completed batches. Anyone signed in reads; the program team (for its campus) and the admin edit.
    match /placements/{id} {
      allow read: if hasProfile();
      allow write: if isAdmin() || (isProgram() && campusOK(get(/databases/$(database)/documents/courses/$(id)).data));
    }

    match /courses/{id} {
      allow read: if hasProfile();
      allow create: if isAdmin()
        // Operations add confirmed batches straight to Upcoming batches; only the admin adds completed courses.
        || (isProgram() && request.resource.data.stage == 'standby' && campusOK(request.resource.data))
        || (isHeadFor(request.resource.data.gati) && request.resource.data.stage == 'pipeline'
            && (rv(request.resource.data) == 'awaiting'
                || (rv(request.resource.data) == 'approved' && request.resource.data.get('courseReady', false) == true)));
      allow update: if isAdmin()
        // Anyone involved: add one message to the log, at any stage.
        || (involved() && changed().hasOnly(['log', 'updatedAt', 'updatedBy'])
            && request.resource.data.get('log', []).size() == resource.data.get('log', []).size() + 1)
        // Operations: standby, running and completed batches; may cancel a standby batch.
        || (isProgram() && campusOK(resource.data) && campusOK(request.resource.data)
            && resource.data.stage in ['standby', 'running', 'actual']
            && request.resource.data.stage in ['standby', 'running', 'actual', 'dropped']
            && (request.resource.data.stage != 'dropped' || resource.data.stage == 'standby'))
        // Course production: upload the course with its lab utilisation, or add a note, while it is in the pipeline.
        || (isCP() && resource.data.stage == 'pipeline' && request.resource.data.stage == 'pipeline'
            && changed().hasOnly(['review', 'log', 'files', 'labs', 'classPct', 'updatedAt', 'updatedBy'])
            && (rv(request.resource.data) == rv(resource.data)
                || (rv(resource.data) in ['awaiting', 'changes'] && rv(request.resource.data) == 'review')))
        // Leadership: approve a confirmed batch (→ standby) or send it back to the GATI head; add notes.
        || (isLead() && resource.data.stage == 'pipeline' && rv(resource.data) == 'leadership'
            && changed().hasOnly(['review', 'stage', 'log', 'leaderApprovedBy', 'leaderApprovedAt', 'history', 'updatedAt', 'updatedBy'])
            && ((request.resource.data.stage == 'standby' && rv(request.resource.data) == 'leadership')
                || (request.resource.data.stage == 'pipeline' && rv(request.resource.data) == 'approved')))
        || (isLead() && resource.data.stage == 'pipeline' && request.resource.data.stage == 'pipeline'
            && changed().hasOnly(['log', 'updatedAt', 'updatedBy']))
        // GATI heads: their own pipeline courses.
        || (isHeadFor(resource.data.gati) && resource.data.stage == 'pipeline' && headPipelineOK())
        // GATI heads: restore their own course dropped before approval.
        || (isHeadFor(resource.data.gati) && resource.data.stage == 'dropped'
            && isHeadFor(request.resource.data.gati) && request.resource.data.stage in ['pipeline', 'dropped'])
        // GATI heads: completed courses, an edit request, or one edit once the program team unlocks it.
        || (isHeadFor(resource.data.gati) && resource.data.stage == 'actual' && request.resource.data.stage == 'actual'
            && (resource.data.get('unlocked', false) == true || changed().hasOnly(['editRequest', 'history'])));
      allow delete: if isAdmin();
    }
  }
}
